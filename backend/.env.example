# BizFlow AI — backend environment template (MVP v1.0)
# Copy to .env locally. Never commit real secrets.
# Actual AI provider keys are deferred to the API integration stage.

NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/bizflow-ai

# Auth (use a long random value in production)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# CORS — production should allow the Vercel frontend origin only
CLIENT_ORIGIN=http://localhost:5173

# HTTPS is required in production (Render). No extra flag required here.

# Placeholder for later AI integration (do not use from the React client)
# AI_PROVIDER_API_KEY=
