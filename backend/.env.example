# BizFlow AI — Backend Environment Template (MVP v1.0)
# Copy this file to .env for local development. Never commit real secrets.

PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bizflow_ai
CLIENT_URL=http://localhost:5176
JWT_SECRET=replace_with_secure_secret

# AI Provider Configuration (Server-side only; never expose to client)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash

# External Communication Providers (Server-side only; defaults to safe sandbox mode)
# Email Configuration (Resend or SMTP)
EMAIL_PROVIDER=sandbox
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# WhatsApp Configuration (Twilio)
WHATSAPP_PROVIDER=sandbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# SMS Configuration (Twilio)
SMS_PROVIDER=sandbox
TWILIO_PHONE_NUMBER=+15551234567

