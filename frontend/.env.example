# BizFlow AI — Frontend Environment Template (MVP v1.0)
# Copy this file to .env.local for local development. Never commit real secrets.

# Backend API Base URL (must include /api prefix)
# Local development default:
VITE_API_BASE_URL=http://localhost:5000/api

# Production example (Render deployment):
# VITE_API_BASE_URL=https://bizflow-ai-backend.onrender.com/api
